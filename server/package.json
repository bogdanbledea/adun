{
  "name": "adun-server",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "node --watch src/index.ts | pino-pretty",
    "start": "node src/index.ts",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.ts\"",
    "migrate": "node src/cli/migrate.ts",
    "backup": "node src/cli/backup.ts",
    "restore": "node src/cli/restore.ts",
    "reset-password": "node src/cli/reset-password.ts",
    "send-test-email": "node src/cli/send-test-email.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "nodemailer": "10.6.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "pino-pretty": "13.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
