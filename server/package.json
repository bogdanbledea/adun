{
  "name": "adun-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "node --watch src/index.ts | pino-pretty",
    "start": "node src/index.ts",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.ts\"",
    "migrate": "node src/cli/migrate.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "pino-pretty": "13.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
