# Copy to .env and adjust. Every variable is optional unless noted. The server
# reads them at startup and refuses to start on an invalid value, naming the
# variable. Empty values count as unset. The README describes each one.

# Public origin of the app, without a path. Required, with https://, since the
# image runs with NODE_ENV=production.
APP_URL=https://adun.example.com

# Reverse proxies in front of the app: 1 behind one proxy or tunnel, 0 only
# when browsers connect to it directly.
TRUST_PROXY_HOPS=1

# Set to false once everyone who should have an account has one.
REGISTRATIONS_ENABLED=true

# Decides the day and the hour reminder emails go out.
TIME_ZONE=Europe/Bucharest

# Email: setting SMTP_HOST turns it on, and then EMAIL_FROM is required.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASSWORD=
# EMAIL_FROM=adun@example.com
# EMAIL_FROM_NAME=adun

# debug, info, warn or error.
LOG_LEVEL=info
